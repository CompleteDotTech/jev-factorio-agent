flowchart TD

subgraph FACTORY["4. Factory planning and optional production capabilities"]
    FP["Use the native recipe, technology<br/>and machine catalog"]:::evidence
    FP_MODE{"Factory scheduling option?"}:::decision
    SERIAL["serial: default<br/>One bounded prerequisite plan"]:::process
    READY_WORK["ready-work: opt-in<br/>Compile once with the effective planner<br/>Bound main lookahead to 32 items and 8 candidates by default"]:::process
    READY_LEDGER["Reuse supply and workload facts within this decision<br/>Consider research resupply and paid recurring producers<br/>Forecast output is not spendable inventory"]:::process
    READY_CAPS["Optional capability-aware planning<br/>Output buffers; input routes;<br/>background craft and research prefetch"]:::process
    READY_SITES["Optional rocket-goal additions<br/>Paid ore-side successors OR mining outposts<br/>Ownership, flow and reservation guards remain active"]:::process
    FP_READY{"Connected player and native<br/>factory telemetry available?"}:::decision
    FP_BIND{"Player bound to existing character?"}:::decision
    EMIT_BIND["Emit factory_bind"]:::process
    CRAFT_BUSY{"Native crafting queue busy?"}:::decision
    BG_WORK["With admitted background craft:<br/>plan only independent work permitted by job locks<br/>Otherwise retain a bounded observation wait"]:::process
    EMIT_WAIT["Emit factory_wait<br/>Observed effect and finite timeout"]:::process
    BOILER_LOW{"Existing boiler below its fuel threshold?"}:::decision
    GOAL_BRANCH{"Requested factory goal?"}:::decision
    NEED_IRON["Need 10 carried iron plates"]:::process
    NEED_SCIENCE["Need 10 carried automation science packs"]:::process
    NEED_LAB["Ensure lab, steam power and network<br/>Wait for powered-lab evidence"]:::process
    NEED_ROCKET_TECH["Ensure rocket-silo technology"]:::process
    NEED["Resolve an item and required quantity"]:::process
    HAVE{"Enough carried inventory?"}:::decision
    SATISFIED["Dependency satisfied<br/>Return to the calling prerequisite"]:::success
    OUTPUT{"Useful stock in an owned output?"}:::decision
    EMIT_EXTRACT["Emit receipt-bound factory_extract<br/>Rank feasible sources by useful pickup cost<br/>Unknown geometry keeps deterministic order"]:::process
    RAW{"Raw resource?"}:::decision
    RAW_EVIDENCE{"Observed resource and validated native site?<br/>Name, surface and finite position"}:::decision
    EMIT_EXPLORE["Emit bounded factory_explore<br/>Add 4 chunks while current radius is below 32<br/>Missing resource at the bound blocks"]:::process
    EMIT_GATHER["Emit factory_gather<br/>One mine for wood; at most 50 other raw units<br/>Failure identity binds site and inventory target"]:::process
    RECIPE["Resolve native recipe<br/>Reject cycles; at most 512 expansions"]:::process
    UNLOCKED{"Recipe unlocked?"}:::decision
    HAND{"Solid recipe is hand-craftable?"}:::decision
    INGREDIENTS["Recursively satisfy paid ingredients"]:::process
    EMIT_CRAFT["Emit factory_craft: at most 20 batches<br/>Background mode wraps supported recipes<br/>with a receipt-tracked craft job"]:::process
    PRODUCTION["Prepare native machine production<br/>Bound batch by ingredient stack capacity"]:::process
    MACHINE["Reuse compatible owned machine<br/>Otherwise acquire its item and emit factory_place"]:::process
    CONFIGURE["Configure unlocked recipe if required<br/>Furnaces use native recipe selection"]:::process
    ENERGY{"Machine energy source?"}:::decision
    FUEL["Base burner policy: refill below 5 coal<br/>Target at most 50, within native stack size<br/>Acquire coal, then receipt-bound insert"]:::process
    POWER["Ensure offshore pump, boiler and steam engine<br/>Physically connect water and steam<br/>Fuel boiler and connect electric poles"]:::process
    INPUTS["Subtract buffered inputs<br/>and the current in-flight craft"]:::process
    INPUT_KIND{"Missing ingredient type?"}:::decision
    SOLID["Acquire solid ingredient<br/>Then emit factory_insert"]:::process
    FLUID["Resolve water, powered oil pumpjack,<br/>or recursive fluid production"]:::process
    FLUID_BUFFERS["Multi-fluid output: ensure tanks<br/>and physical output connections"]:::process
    CONNECT["Require carried pipes or poles<br/>Physical route budget at most 1200 components"]:::process
    EMIT_CONNECT["Emit factory_connect with native endpoints"]:::process
    PRODUCTION_WAIT["Wait for native machine output"]:::process
    RESEARCH["Ensure native technology"]:::process
    TECH_DONE{"Already researched?"}:::decision
    TECH_PARENTS["Recursively ensure prerequisite technologies"]:::process
    TRIGGER{"Native research trigger?"}:::decision
    TRIGGER_CRAFT["Require native produced count<br/>Acquire additional crafted items; wait for unlock"]:::process
    TRIGGER_OIL["Ensure native oil extraction<br/>Wait for technology unlock"]:::process
    TECH_LAB["Ensure powered lab"]:::process
    TECH_ACTIVE{"Research active?"}:::decision
    EMIT_RESEARCH["Emit factory_research"]:::process
    SCIENCE_INPUT["Acquire and insert required science packs<br/>Ready-work may prefetch before starvation"]:::process
    RESEARCH_WAIT["Wait for observed research progress<br/>Ready-work coalesces checks with refill deadlines"]:::process
    LAUNCH_PREP["After rocket-silo research: verify launch readiness<br/>Build paid landing pad; collect reachable fish or satellite<br/>Preserve unresolved pad, cargo and launch receipts"]:::process
    LAUNCH_PAYLOAD["When rocket ready, load one paid payload<br/>Verify destination capacity and exact rocket identity<br/>Do not change automatic-launch settings"]:::process
    SILO_READY{"Native silo rocket ready?"}:::decision
    EMIT_LAUNCH["Emit factory_launch<br/>Verify the native launch event/counter"]:::process
    PARTS_DONE{"Required rocket parts complete?"}:::decision
    ROCKET_BUILD["Produce remaining rocket parts<br/>At most 10 batches per request"]:::process
    EMITTED["Return bounded prerequisite candidates<br/>Replan from observed effects"]:::process
    FP_POST{"Ready-work enabled?"}:::decision
    FP_SERVICE["Bounded sequential service visits<br/>Default at most 3 already-feasible transfers<br/>Never spend forecast collections"]:::process
    FP_CAPITAL["Final composed frontier<br/>Protect urgent supply and committed capital kit<br/>Optional profitable investment is paid and bounded"]:::process
    FP_CAPITAL_PROOF["Capital completion requires the same owned unit,<br/>native production counter growth and real output<br/>Deadline or reconciled failures may abandon intent"]:::evidence
    CAP_OUTPUT["Optional furnace output cells<br/>Paid burner inserter and chest<br/>Collect commissioned stock before upstream refill"]:::process
    CAP_INPUT["Optional iron/copper furnace input routes<br/>Paid drill, bounded belts and inserter<br/>Require current topology and native flow evidence"]:::process
    CAP_FUEL["Manual fuel-service batching for demanded cells<br/>Combine due deficits for up to 16 small burners<br/>Acquire at most 50 coal; transfer and replan serially"]:::process
    CAP_LIMITS["Current logistics boundary<br/>Outposts cover iron/copper and still need manual hauling<br/>No general coal-distribution or downstream belt planner"]:::caution

    COMPILE -->|Native factory goal| FP --> FP_MODE
    FP_MODE -->|Default| SERIAL --> FP_READY
    FP_MODE -->|Explicit ready-work| READY_WORK --> READY_LEDGER --> READY_CAPS --> READY_SITES --> FP_READY
    READY_CAPS -. output-buffer option .-> CAP_OUTPUT
    READY_CAPS -. input-belt option requires output buffers .-> CAP_INPUT
    CAP_OUTPUT --> CAP_FUEL
    CAP_INPUT --> CAP_FUEL
    CAP_FUEL -. current scope .-> CAP_LIMITS
    READY_SITES -. scope .-> CAP_LIMITS
    FP_READY -->|No| BLOCKED
    FP_READY -->|Yes| FP_BIND
    FP_BIND -->|No| EMIT_BIND --> EMITTED
    FP_BIND -->|Yes| CRAFT_BUSY
    CRAFT_BUSY -->|Yes| BG_WORK
    BG_WORK -->|No admitted independent work| EMIT_WAIT --> EMITTED
    BG_WORK -->|Safe independent candidate| EMITTED
    CRAFT_BUSY -->|No| BOILER_LOW
    BOILER_LOW -->|Yes| FUEL
    BOILER_LOW -->|No| GOAL_BRANCH
    GOAL_BRANCH -->|Iron smelting| NEED_IRON --> NEED
    GOAL_BRANCH -->|Automation science| NEED_SCIENCE --> NEED
    GOAL_BRANCH -->|Steam power| NEED_LAB --> MACHINE
    GOAL_BRANCH -->|Rocket launch| NEED_ROCKET_TECH --> RESEARCH
    NEED --> HAVE
    HAVE -->|Yes| SATISFIED
    HAVE -->|No| OUTPUT
    OUTPUT -->|Yes| EMIT_EXTRACT --> EMITTED
    OUTPUT -->|No| RAW
    RAW -->|Yes| RAW_EVIDENCE
    RAW_EVIDENCE -->|No| EMIT_EXPLORE --> EMITTED
    RAW_EVIDENCE -->|Yes| EMIT_GATHER --> EMITTED
    RAW -->|No| RECIPE --> UNLOCKED
    UNLOCKED -->|No| RESEARCH
    UNLOCKED -->|Yes| HAND
    HAND -->|Yes| INGREDIENTS
    INGREDIENTS -->|Missing dependency| NEED
    INGREDIENTS -->|Available| EMIT_CRAFT --> EMITTED
    HAND -->|No| PRODUCTION
    PRODUCTION --> MACHINE --> CONFIGURE --> ENERGY
    MACHINE -->|Material missing| NEED
    MACHINE -->|Placement needed| EMITTED
    CONFIGURE -->|Configuration needed| EMITTED
    ENERGY -->|Electric| POWER --> CONNECT
    ENERGY -->|Burner| FUEL
    ENERGY -->|Supplied| INPUTS
    FUEL -->|Coal missing| NEED
    FUEL -->|Transfer needed| EMITTED
    FUEL -->|Fuel sufficient| INPUTS
    INPUTS --> INPUT_KIND
    INPUT_KIND -->|Solid| SOLID
    SOLID -->|Material missing| NEED
    SOLID -->|Available| EMITTED
    INPUT_KIND -->|Fluid| FLUID
    FLUID -->|Production needed| RECIPE
    FLUID -->|Multiple fluid outputs| FLUID_BUFFERS --> CONNECT
    FLUID -->|Source ready| CONNECT
    CONNECT -->|Materials missing| NEED
    CONNECT -->|Connection missing| EMIT_CONNECT --> EMITTED
    CONNECT -->|Already connected| SATISFIED
    INPUT_KIND -->|Supplied| PRODUCTION_WAIT --> EMIT_WAIT
    RESEARCH --> TECH_DONE
    TECH_DONE -->|No| TECH_PARENTS --> TRIGGER
    TECH_PARENTS -->|Parent missing| RESEARCH
    TRIGGER -->|Craft item| TRIGGER_CRAFT --> NEED
    TRIGGER -->|Mine crude oil| TRIGGER_OIL --> FLUID
    TRIGGER -->|Unsupported trigger| BLOCKED
    TRIGGER -->|Science-based| TECH_LAB --> TECH_ACTIVE
    TECH_LAB -->|Infrastructure missing| MACHINE
    TECH_ACTIVE -->|None| EMIT_RESEARCH --> EMITTED
    TECH_ACTIVE -->|Different technology| RESEARCH
    TECH_ACTIVE -->|Requested technology| SCIENCE_INPUT
    SCIENCE_INPUT -->|Packs missing| NEED
    SCIENCE_INPUT -->|Insertion needed| EMITTED
    SCIENCE_INPUT -->|Supplied| RESEARCH_WAIT --> EMIT_WAIT
    TECH_DONE -->|Ordinary prerequisite satisfied| SATISFIED
    TECH_DONE -->|Rocket-silo research satisfied| LAUNCH_PREP
    LAUNCH_PREP -->|Pad or payload prerequisite needed| EMITTED
    LAUNCH_PREP -->|Cargo ready to load| LAUNCH_PAYLOAD --> EMITTED
    LAUNCH_PREP -->|Preparation satisfied or payload held| SILO_READY
    SILO_READY -->|Yes| EMIT_LAUNCH --> EMITTED
    SILO_READY -->|No| PARTS_DONE
    PARTS_DONE -->|Yes| EMIT_WAIT
    PARTS_DONE -->|No| ROCKET_BUILD --> PRODUCTION
    EMITTED --> FP_POST
    FP_POST -->|Serial| FILTER
    FP_POST -->|Ready-work| FP_SERVICE --> FP_CAPITAL --> FILTER
    FP_CAPITAL -. completion authority .-> FP_CAPITAL_PROOF
end


    BLOCKED["Mark blocked<br/>Retain exact reason and failure history"]
    COMPILE["Compile the effective capability-aware frontier<br/>Bootstrap, serial or ready-work planner<br/>Then apply committed-capital constraints"]
    FILTER["Apply two-failure plan budget<br/>Include connection failure attribution"]
class BLOCKED,COMPILE,FILTER continuation;

classDef process fill:#e5edf5,stroke:#7694aa,color:#243b43,stroke-width:1.4px;
classDef decision fill:#f4ead4,stroke:#b99b62,color:#4b412d,stroke-width:1.4px;
classDef evidence fill:#eee9f4,stroke:#9a89b0,color:#433b53,stroke-width:1.4px;
classDef success fill:#e2eee4,stroke:#7f9e85,color:#2e4835,stroke-width:1.4px;
classDef caution fill:#f3e4d8,stroke:#bd9276,color:#543e30,stroke-width:1.4px;
classDef stop fill:#f2e1e5,stroke:#b7808d,color:#59353f,stroke-width:1.4px;
classDef continuation fill:#edf0ed,stroke:#8b9a92,color:#3d4e46,stroke-width:1.4px,stroke-dasharray:5 4;
style FACTORY fill:#edf1eb,stroke:#b5c3bf,color:#304b50,stroke-width:1.4px;
