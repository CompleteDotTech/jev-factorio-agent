    TRIGGER_OIL["Ensure native oil extraction<br/>Wait for technology unlock"]:::process
    TECH_LAB["Ensure powered lab"]:::process
    TECH_ACTIVE{"Research active?"}:::decision
    EMIT_RESEARCH["Emit factory_research"]:::process
    SCIENCE_INPUT["Acquire and insert required science packs<br/>Ready-work may prefetch before starvation"]:::process
    RESEARCH_WAIT["Wait for observed research progress<br/>Ready-work coalesces checks with refill deadlines"]:::process
    LAUNCH_PREP["After rocket-silo research: verify launch readiness<br/>Build paid landing pad; collect reachable fish or satellite<br/>Preserve unresolved pad, cargo and launch receipts"]:::process
    LAUNCH_PAYLOAD["When rocket ready, load one paid payload<br/>Verify destination capacity and exact rocket identity<br/>Do not change automatic-launch settings"]:::process
    SILO_READY{"Native silo rocket ready?"}:::decision
    EMIT_LAUNCH["Emit factory_launch<br/>Verify the native launch event/counter"]:::process
    PARTS_DONE{"Required rocket parts complete?"}:::decision
    ROCKET_BUILD["Produce remaining rocket parts<br/>At most 10 batches per request"]:::process
