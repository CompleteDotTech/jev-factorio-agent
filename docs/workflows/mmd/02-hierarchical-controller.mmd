flowchart TD

subgraph CTRL["2. Hierarchical controller"]
    OBS["Observe backend and enabled capabilities<br/>Native entities, receipts, research,<br/>owned routes, jobs and launch evidence"]:::evidence
    VALID{"Session, finite facts and monotonic tick valid?<br/>Enabled capabilities match retained ownership?"}:::decision
    PENDING{"Running or uncertain controller<br/>has an unresolved pending action?"}:::decision
    TERMINAL{"Completed, blocked or uncertain?"}:::decision
    ADMISSION{"Maintenance and storage<br/>admit new work?"}:::decision
    GOALS["Check prerequisite-ordered native predicates<br/>Retain previously verified milestones<br/>Defer goal changes during tracked background craft"]:::process
    TARGET_DONE{"Target milestone verified?"}:::decision
    COMPLETE_RECORD["Persist completed checkpoint<br/>Record verified completion and publish status"]:::evidence
    ACTIVE{"Committed plan exists?"}:::decision
    COMPILE["Compile the effective capability-aware frontier<br/>Bootstrap, serial or ready-work planner<br/>Then apply committed-capital constraints"]:::process
    FILTER["Apply two-failure plan budget<br/>Include connection failure attribution"]:::process
    CANDIDATES{"Eligible plans remain?"}:::decision
    BLOCKED["Mark blocked<br/>Retain exact reason and failure history"]:::stop
    RANK["Ready-work: deduplicate and rank<br/>Urgency, immediate need, estimated actor cost<br/>Heuristics do not authorize execution"]:::process
    POLICY{"Selection policy?"}:::decision
    DETERMINISTIC["Choose ready-work ranking first<br/>Otherwise step count, then plan ID"]:::process
    COMMIT["Commit selected plan and step index<br/>Persist any capital or successor intent"]:::process
    FRESH["Observe again before dispatch<br/>Recheck capability, maintenance and storage barriers"]:::evidence
    BARRIER{"Safe to execute now?"}:::decision
    SKIP["Skip steps with observed postconditions"]:::process
    PLAN_DONE{"All plan effects already satisfied?"}:::decision
    PRECONDITION{"Next step allowed by native state,<br/>ownership, locks and capital budget?"}:::decision
    RESERVE{"Required carried materials available<br/>for reservation?"}:::decision
    WRITEAHEAD["Persist pending = prepared BEFORE dispatch<br/>Attempt identity, receipt, start tick and polls"]:::process
    DISPATCH["Execute one committed step<br/>One dispatcher; no concurrent game mutations"]:::process
    DISPATCH_ERROR{"Which exception contract?"}:::decision
    LOCAL_HOLD["Proven local maintenance or storage rejection<br/>Record rejected attempt; clear pending<br/>Retain plan and reservations"]:::caution
    AMBIGUOUS["Persist ambiguous dispatch and error<br/>Retain pending for reconciliation<br/>Never blindly replay"]:::caution
    RETURN_STATE["Persist dispatch = returned"]:::process
    AFTER["Observe after dispatch<br/>Apply the composed execution barrier"]:::evidence
    EFFECT{"Native postcondition satisfied?"}:::decision
    BG_ADMIT{"Background mode: accepted craft receipt<br/>and paid-input evidence permit admission?"}:::decision
    BG_TRACK["Persist job and original attempt<br/>Lock future outputs; release paid-input reservation<br/>Independent actions remain serial"]:::process
    VERIFIED["Record verified attempt; release reservation<br/>Clear pending, advance step<br/>Reset stalled-decision count"]:::success
    REMAINING{"More committed steps?"}:::decision
    CLEAR["Clear completed plan<br/>Refresh goal predicates when no background job"]:::process
    FAILPLAN["Increment plan failure count<br/>Release reservation and clear plan<br/>Retain failures and paid construction"]:::caution
    RECORD["Save checkpoint; append configured logs<br/>Publish truthful status, decisions and evidence"]:::evidence
    CADENCE["Wait configured interval within deadline<br/>Ready-work acknowledged research waits may back off<br/>No fixed deployed interval is assumed"]:::process
    GAME_ERROR["Unhandled controller, persistence<br/>or backend failure"]:::stop

    LAUNCH --> OBS --> VALID
    VALID -->|No| GAME_ERROR
    VALID -->|Yes| PENDING
    PENDING -->|Yes| VERIFY_PENDING
    PENDING -->|No| TERMINAL
    TERMINAL -->|Yes| RECORD
    TERMINAL -->|No| ADMISSION
    ADMISSION -->|Held| RECORD
    ADMISSION -->|Admitted| GOALS --> TARGET_DONE
    TARGET_DONE -->|Yes| COMPLETE_RECORD --> SUCCESS
    TARGET_DONE -->|No| ACTIVE
    ACTIVE -->|Yes| FRESH
    ACTIVE -->|No| COMPILE
    COMPILE --> FILTER --> CANDIDATES
    CANDIDATES -->|No| BLOCKED --> RECORD
    CANDIDATES -->|Yes| RANK --> POLICY
    POLICY -->|Deterministic, or healthy-provider hybrid with one ready-work choice| DETERMINISTIC
    POLICY -->|Jev or remaining hybrid cases| JEV_BATCH
    DETERMINISTIC --> COMMIT
    COMMIT --> FRESH --> BARRIER
    BARRIER -->|Held or fault| RECORD
    BARRIER -->|Yes| SKIP --> PLAN_DONE
    PLAN_DONE -->|Yes| CLEAR
    PLAN_DONE -->|No| PRECONDITION
    PRECONDITION -->|No| FAILPLAN
    PRECONDITION -->|Yes| RESERVE
    RESERVE -->|No| FAILPLAN
    RESERVE -->|Yes| WRITEAHEAD --> DISPATCH --> ACTION_TYPE
    NATIVE_ERROR --> DISPATCH_ERROR
    DISPATCH_ERROR -->|Local maintenance or storage guard proves no dispatch| LOCAL_HOLD --> RECORD
    DISPATCH_ERROR -->|Explicit connection preflight rejection| FAILPLAN
    DISPATCH_ERROR -->|Research recorder failed| GAME_ERROR
    DISPATCH_ERROR -->|Other error or lost acknowledgement| AMBIGUOUS --> RECORD
    NATIVE_RETURN --> RETURN_STATE --> AFTER
    AFTER -->|Capability fault| RECORD
    AFTER -->|Valid| EFFECT
    EFFECT -->|No| BG_ADMIT
    BG_ADMIT -->|Yes| BG_TRACK --> RECORD
    BG_TRACK -. retained craft observations .-> BG_WATCH
    BG_ADMIT -->|No| RECORD
    EFFECT -->|Yes| VERIFIED --> REMAINING
    REMAINING -->|Yes| RECORD
    REMAINING -->|No| CLEAR --> RECORD
    FAILPLAN --> RECORD
    RECORD --> CADENCE
    CADENCE -->|Running and budget remains| OBS
    CADENCE -->|Terminal or deadline| WATCH
    GAME_ERROR --> INCIDENT
end


    ACTION_TYPE{"Committed native action type?<br/>One controller dispatch at a time"}
    BG_WATCH["Every later observation checks job identity,<br/>monotonic progress, deadline and earned output<br/>Persist before allowing independent work"]
    INCIDENT["Stop and reap owned gameplay process<br/>Classify latest checkpoint and matching exit evidence"]
    JEV_BATCH["Select from current feasible plans<br/>Ready-work: deduplicate and rank evidence<br/>Rebuild selection state each decision"]
    LAUNCH["Resume FLE hierarchical controller<br/>Same checkpoint and session; remaining time only<br/>Hybrid policy; Jev 1.13.0; configured features"]
    NATIVE_ERROR["Factory adapter raised an error<br/>Controller distinguishes exact preflight rejection<br/>from a potentially partial mutation"]
    NATIVE_RETURN["Adapter returned; success is not yet verified<br/>Legacy FLE act may return an error string<br/>Controller observes the required postcondition"]
    SUCCESS["Controller checkpoint reports completed<br/>Stop owned gameplay process<br/>Supervisor records campaign completion"]
    VERIFY_PENDING["Fresh observation before new planning<br/>Background extension also checks its retained job"]
    WATCH["Monitor checkpoint, owned process and fresh health<br/>Default polling interval: 5 seconds"]
class ACTION_TYPE,BG_WATCH,INCIDENT,JEV_BATCH,LAUNCH,NATIVE_ERROR,NATIVE_RETURN,SUCCESS,VERIFY_PENDING,WATCH continuation;

classDef process fill:#e5edf5,stroke:#7694aa,color:#243b43,stroke-width:1.4px;
classDef decision fill:#f4ead4,stroke:#b99b62,color:#4b412d,stroke-width:1.4px;
classDef evidence fill:#eee9f4,stroke:#9a89b0,color:#433b53,stroke-width:1.4px;
classDef success fill:#e2eee4,stroke:#7f9e85,color:#2e4835,stroke-width:1.4px;
classDef caution fill:#f3e4d8,stroke:#bd9276,color:#543e30,stroke-width:1.4px;
classDef stop fill:#f2e1e5,stroke:#b7808d,color:#59353f,stroke-width:1.4px;
classDef continuation fill:#edf0ed,stroke:#8b9a92,color:#3d4e46,stroke-width:1.4px,stroke-dasharray:5 4;
style CTRL fill:#edf2f5,stroke:#b5c3bf,color:#304b50,stroke-width:1.4px;
