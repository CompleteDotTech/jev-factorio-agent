flowchart TD

subgraph REPAIR["8. Recovery classification and bounded source repair"]
    INCIDENT["Stop and reap owned gameplay process<br/>Classify latest checkpoint and matching exit evidence"]:::caution
    SOURCE_DEFECT{"Explicit source-defect evidence digest<br/>for this execution and session,<br/>with no pending/background ambiguity?"}:::decision
    OPERATOR_BLOCK["Block for operator reconciliation; exit 2<br/>Provider, quota, storage, native failure,<br/>uncertain outcome or unclassified exit<br/>Preserve pending actions and original cutoff"]:::stop
    REPAIR_BASELINE["Capture immutable incident checkpoint and source<br/>Reuse this baseline after rejection or restart"]:::evidence
    REPAIR_TIME{"Time remains before original cutoff<br/>and no stop request?"}:::decision
    REPAIR_BUDGET{"Incident repair budget available<br/>and repair account unblocked?"}:::decision
    CODEX["Persist attempt and audit identity<br/>Launch configured repair command with prompt<br/>Default attempt limit: 30 minutes, capped by cutoff"]:::process
    DIAGNOSE["Diagnose source, logs and available native evidence<br/>Preserve session, pending and fairness<br/>Repair agent must not launch gameplay"]:::process
    CHANGE_TYPE{"Code change needed?"}:::decision
    OPERATIONAL["Evidence-backed operational reconciliation<br/>Source identity and HEAD unchanged<br/>Pending and reservations remain for controller verification"]:::evidence
    IMPLEMENT["Implement focused fix and regression tests<br/>Run focused and full tests<br/>Keep normal walking, mining, reach and 1x speed"]:::process
    PUBLISH["Commit and push focused repair branch<br/>Open or update pull request"]:::process
    REVIEW["Independent review of exact PR head<br/>GitHub approval or separate-agent source artifact"]:::evidence
    CI{"Checks pass and exact-head review approves<br/>with no outstanding changes requested?"}:::decision
    MERGE["Merge without bypassing branch rules<br/>Synchronize clean local HEAD and origin/main<br/>Also synchronize fork/main if configured"]:::process
    RESULT["Write structured result with concrete evidence<br/>Code and operational claims have distinct requirements"]:::evidence
    ACCEPT["Supervisor validates checkpoint and report<br/>Preserve pending, attempt, plans, reservations,<br/>background commitments, outcomes and failure budgets"]:::process
    ACCEPT_CODE["For code: independently verify merged PR, review,<br/>checks, exact commit, clean tree and remote main tips<br/>Run full pytest or validate exact prevalidation artifact"]:::evidence
    ACCEPT_PROOF["Recheck unchanged result bytes and source revision<br/>Record source segment and durable acceptance event"]:::evidence
    ACCEPTED{"Repair accepted and audit durable?"}:::decision
    RETRY["Keep gameplay stopped; record rejected attempt<br/>Exponential backoff capped at 15 minutes<br/>Default budget: 3 attempts per incident"]:::caution
    QUOTA{"Repair account quota exhausted<br/>or incident attempt budget spent?"}:::decision
    READY["Clear accepted repair-required gate<br/>Keep original world, checkpoint and cutoff<br/>Only supervisor may resume gameplay"]:::success

    INCIDENT --> SOURCE_DEFECT
    SOURCE_DEFECT -->|No| OPERATOR_BLOCK
    SOURCE_DEFECT -->|Yes| REPAIR_BASELINE --> REPAIR_TIME
    REPAIR_TIME -->|No| STOP
    REPAIR_TIME -->|Yes| REPAIR_BUDGET
    REPAIR_BUDGET -->|No| OPERATOR_BLOCK
    REPAIR_BUDGET -->|Yes| CODEX
    CODEX --> DIAGNOSE --> CHANGE_TYPE
    CHANGE_TYPE -->|No| OPERATIONAL --> RESULT
    CHANGE_TYPE -->|Yes| IMPLEMENT --> PUBLISH --> REVIEW --> CI
    CI -->|No| IMPLEMENT
    CI -->|Yes| MERGE --> RESULT
    RESULT -->|Repair process exits successfully| ACCEPT
    ACCEPT -->|Code claim| ACCEPT_CODE
    ACCEPT_CODE -->|Verified| ACCEPT_PROOF
    ACCEPT_CODE -->|Rejected| QUOTA
    ACCEPT -->|Operational claim and unchanged source| ACCEPT_PROOF
    ACCEPT -->|Invalid claim or changed protected state| QUOTA
    ACCEPT_PROOF --> ACCEPTED
    CODEX -->|Timeout, failure or quota limit| QUOTA
    ACCEPTED -->|No| QUOTA
    QUOTA -->|Yes| OPERATOR_BLOCK
    QUOTA -->|No| RETRY --> REPAIR_TIME
    ACCEPTED -->|Yes| READY --> DEADLINE
end


    DEADLINE{"Original cutoff reached<br/>or stop requested?"}
    STOP["Stop and reap owned child processes<br/>Preserve world, checkpoint and original cutoff"]
class DEADLINE,STOP continuation;

classDef process fill:#e5edf5,stroke:#7694aa,color:#243b43,stroke-width:1.4px;
classDef decision fill:#f4ead4,stroke:#b99b62,color:#4b412d,stroke-width:1.4px;
classDef evidence fill:#eee9f4,stroke:#9a89b0,color:#433b53,stroke-width:1.4px;
classDef success fill:#e2eee4,stroke:#7f9e85,color:#2e4835,stroke-width:1.4px;
classDef caution fill:#f3e4d8,stroke:#bd9276,color:#543e30,stroke-width:1.4px;
classDef stop fill:#f2e1e5,stroke:#b7808d,color:#59353f,stroke-width:1.4px;
classDef continuation fill:#edf0ed,stroke:#8b9a92,color:#3d4e46,stroke-width:1.4px,stroke-dasharray:5 4;
style REPAIR fill:#f4ede7,stroke:#b5c3bf,color:#304b50,stroke-width:1.4px;
