{
  "theme": "base",
  "layout": "elk",
  "securityLevel": "strict",
  "maxTextSize": 100000,
  "maxEdges": 1000,
  "themeVariables": {
    "fontFamily": "Trebuchet MS, Verdana, DejaVu Sans, sans-serif",
    "fontSize": "18px",
    "primaryColor": "#e5edf5",
    "primaryTextColor": "#243b43",
    "primaryBorderColor": "#7694aa",
    "lineColor": "#657b80",
    "secondaryColor": "#e6eee5",
    "tertiaryColor": "#eee9f4",
    "clusterBkg": "#f0f2ed",
    "clusterBorder": "#b8c6bd",
    "edgeLabelBackground": "#f6f5f0",
    "background": "#f6f5f0",
    "titleColor": "#304b50"
  },
  "flowchart": {
    "htmlLabels": true,
    "useMaxWidth": false,
    "nodeSpacing": 42,
    "rankSpacing": 60,
    "padding": 18,
    "diagramPadding": 30,
    "curve": "basis",
    "wrappingWidth": 300
  }
}
