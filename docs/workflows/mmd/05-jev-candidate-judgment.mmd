flowchart TD

subgraph JEV["5. Jev candidate judgment"]
    JEV_BATCH["Select from current feasible plans<br/>Ready-work: deduplicate and rank evidence<br/>Rebuild selection state each decision"]:::process
    MODEL_SKIP{"Deterministic policy, or hybrid ready-work<br/>with one distinct plan and healthy provider?"}:::decision
    MODEL_STATE["Facts, goal and last eight history events<br/>Include scheduling evidence when available<br/>Omit raw transfer receipts and connector lists"]:::evidence
    QUESTIONS["Offer up to 16 plans plus observe<br/>One choice and, for each plan:<br/>benefit 0–2, disruption 0–2,<br/>missing-start-evidence value 0–1"]:::process
    SIZE{"Serialized state + questions fit budget?<br/>Default: 32,000 UTF-8 bytes"}:::decision
    TRIM["Drop final candidate and rebuild<br/>Byte bound is not a token estimate"]:::process
    PROVIDER_GATE{"HTTP provider circuit admits a call?<br/>Cooldown, exhaustion and interrupted requests<br/>retain their durable incident budget"}:::decision
    API["Persist request reservation when configured<br/>Call client once for the entire batch<br/>HTTP clients use a 10-second timeout"]:::process
    API_RESULT{"Provider result?"}:::decision
    PROVIDER_HOLD["Record provider hold; keep observing<br/>No hybrid fallback or stall-budget charge<br/>No sleep inside provider evaluation"]:::caution
    PROVIDER_BUDGET["HTTP failure budgets: auth or quota: 3;<br/>network or rate limit: 8; schema: 1<br/>Interrupted healthy request exhausts at one<br/>Backoff and bounded Retry-After; persist budget"]:::evidence
    ANSWER_VALID{"Exact question keys and answer types?<br/>Finite values, complete distributions,<br/>matching rubrics and consistent choice/scores?<br/>Respect supported provider rounding"}:::decision
    GLOBAL_GATE{"Model chose observe<br/>or choice confidence below floor?<br/>Default floor: 0.45"}:::decision
    PER_PLAN["Exclude candidates needing evidence ≥ 0.5<br/>or benefit/disruption confidence below floor"]:::process
    UTILITY["Rank eligible offered plans:<br/>choice probability + benefit / 4<br/>− disruption / 8 − 0.02 per step<br/>A heuristic, not success probability"]:::process
    WINNER{"Any eligible candidate?"}:::decision
    JEV_CHOSEN["Select maximum-utility plan<br/>It can differ from the choice label"]:::success
    NO_DECISION["No usable model decision<br/>Retain reason and rejection diagnostics"]:::caution
    FALLBACK_POLICY{"Hybrid policy?"}:::decision
    FALLBACK["Ready-work: first available evidence-ranked plan<br/>Otherwise: fewest steps, then plan ID<br/>Uses feasible plans before model-byte pruning"]:::process
    STALL["Strict Jev: observe without mutation<br/>Increment stalled-decision count"]:::caution
    STALL_LIMIT{"Configured stall limit reached?<br/>Default: four decisions"}:::decision

    JEV_BATCH --> MODEL_SKIP
    MODEL_SKIP -->|Yes| FALLBACK
    MODEL_SKIP -->|No| MODEL_STATE --> QUESTIONS --> SIZE
    SIZE -->|No| TRIM
    TRIM -->|Candidates remain| QUESTIONS
    TRIM -->|None remain or invalid request| NO_DECISION
    SIZE -->|Yes| PROVIDER_GATE
    PROVIDER_GATE -->|Blocked| PROVIDER_HOLD
    PROVIDER_GATE -->|Admitted, or non-HTTP client| API --> API_RESULT
    API_RESULT -->|HTTP circuit records categorized failure| PROVIDER_HOLD
    PROVIDER_HOLD -. budget policy .-> PROVIDER_BUDGET
    PROVIDER_HOLD --> RECORD
    API_RESULT -->|Unwrapped transient failure or invalid payload| NO_DECISION
    API_RESULT -->|Unhandled error or persistence failure| GAME_ERROR
    API_RESULT -->|Answers received| ANSWER_VALID
    ANSWER_VALID -->|No| NO_DECISION
    ANSWER_VALID -->|Yes| GLOBAL_GATE
    GLOBAL_GATE -->|Yes| NO_DECISION
    GLOBAL_GATE -->|No| PER_PLAN --> UTILITY --> WINNER
    WINNER -->|Yes| JEV_CHOSEN --> COMMIT
    WINNER -->|No| NO_DECISION
    NO_DECISION --> FALLBACK_POLICY
    FALLBACK_POLICY -->|Yes| FALLBACK --> COMMIT
    FALLBACK_POLICY -->|No| STALL --> STALL_LIMIT
    STALL_LIMIT -->|Yes| BLOCKED
    STALL_LIMIT -->|No| RECORD
end


    BLOCKED["Mark blocked<br/>Retain exact reason and failure history"]
    COMMIT["Commit selected plan and step index<br/>Persist any capital or successor intent"]
    GAME_ERROR["Unhandled controller, persistence<br/>or backend failure"]
    RECORD["Save checkpoint; append configured logs<br/>Publish truthful status, decisions and evidence"]
class BLOCKED,COMMIT,GAME_ERROR,RECORD continuation;

classDef process fill:#e5edf5,stroke:#7694aa,color:#243b43,stroke-width:1.4px;
classDef decision fill:#f4ead4,stroke:#b99b62,color:#4b412d,stroke-width:1.4px;
classDef evidence fill:#eee9f4,stroke:#9a89b0,color:#433b53,stroke-width:1.4px;
classDef success fill:#e2eee4,stroke:#7f9e85,color:#2e4835,stroke-width:1.4px;
classDef caution fill:#f3e4d8,stroke:#bd9276,color:#543e30,stroke-width:1.4px;
classDef stop fill:#f2e1e5,stroke:#b7808d,color:#59353f,stroke-width:1.4px;
classDef continuation fill:#edf0ed,stroke:#8b9a92,color:#3d4e46,stroke-width:1.4px,stroke-dasharray:5 4;
style JEV fill:#f0edf4,stroke:#b5c3bf,color:#304b50,stroke-width:1.4px;
